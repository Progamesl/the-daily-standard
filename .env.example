# Copy this file to .env and fill in your values

# Supabase (database + auth)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# R2 (images via Cloudflare Worker — no egress fees). Optional; if set, used before Cloudinary/Imgur.
# VITE_R2_UPLOAD_URL=https://octagon-r2-upload.YOUR_SUBDOMAIN.workers.dev
# VITE_R2_SECRET=your_secret_for_X-R2-Secret_header

# Cloudinary (images — keeps Supabase egress low). Used if R2 is not configured.
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# EmailOctopus newsletter
# VITE_EMAILOCTOPUS_API_KEY=your_api_key_here
# VITE_EMAILOCTOPUS_LIST_ID=your_list_id_here
